#!/usr/bin/env bash
set -euo pipefail

event="${1:-unknown}"
input="$(cat)"
log="${SG_S02_LOG:-${TMPDIR:-/tmp}/skill-graph-s02-hooks.jsonl}"
state_dir="${SG_S02_STATE:-${TMPDIR:-/tmp}/skill-graph-s02-state}"
mkdir -p "$(dirname "$log")" "$state_dir"

printf '%s\n' "$input" | jq -c --arg hook "$event" '{
  hook: $hook,
  hook_event_name: .hook_event_name,
  session_id,
  cwd,
  prompt,
  tool_name,
  tool_input,
  tool_response,
  expansion_type,
  command_name,
  command_args,
  command_source,
  source
}' >> "$log"

session_id="$(printf '%s' "$input" | jq -r '.session_id // "unknown"')"

case "$event" in
  session-start)
    marker="$state_dir/$session_id.session-start"
    if [ ! -e "$marker" ]; then
      touch "$marker"
      jq -nc '{hookSpecificOutput:{hookEventName:"SessionStart",additionalContext:"skill-graph-demo: session-start recommendation hook fired once for this session."}}'
    fi
    ;;
  user-prompt)
    prompt="$(printf '%s' "$input" | jq -r '.prompt // ""')"
    if [[ "$prompt" == *recommend* ]]; then
      marker="$state_dir/$session_id.user-prompt-recommend"
      if [ ! -e "$marker" ]; then
        touch "$marker"
        jq -nc --arg prompt "${prompt:0:120}" '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:("skill-graph-demo: prompt contains recommend; first recommendation context for prompt=" + $prompt)}}'
      fi
    fi
    ;;
  *)
    ;;
esac
