{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-graph.local/contracts/v1/skill-summary.schema.json",
  "title": "SkillSummary",
  "type": "object",
  "required": ["name", "description", "path", "root", "digest", "availability", "spec_violations"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "path": { "type": "string", "minLength": 1 },
    "root": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "minLength": 1 },
    "availability": { "type": "string", "enum": ["available", "parse_error"] },
    "spec_violations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
